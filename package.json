{
  "name": "@metaxia/scriptures",
  "version": "3.1.0",
  "description": "A batteries-included JavaScript library for biblical scriptures, morphology, and lexicons. Bundles core library with all official data sources.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "test -f node_modules/.bin/tsc && npm run build || true",
    "clean": "rm -rf dist",
    "test": "vitest run && node --test tests/*.test.mjs",
    "report": "tsx scripts/alignment-report.ts"
  },
  "keywords": [
    "bible",
    "scripture",
    "gematria",
    "hebrew",
    "greek",
    "morphology",
    "strongs",
    "kjv",
    "textus-receptus",
    "septuagint"
  ],
  "author": "Benjamin Plunkert",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metaxiamultimedia/scriptures-js.git"
  },
  "bugs": {
    "url": "https://github.com/metaxiamultimedia/scriptures-js/issues"
  },
  "homepage": "https://github.com/metaxiamultimedia/scriptures-js#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@metaxia/scriptures-core": "^3.1.0",
    "@metaxia/scriptures-source-crosswire-kjv": "^2.1.0",
    "@metaxia/scriptures-source-openscriptures-ohb": "3.0.0",
    "@metaxia/scriptures-source-stepbible-lexicon": "2.2.0",
    "@metaxia/scriptures-source-stepbible-tagnt-tr": "^2.0.4",
    "@metaxia/scriptures-source-stepbible-versification": "^0.1.3",
    "@metaxia/scriptures-source-stepbible-tahot": "1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.0"
  }
}
